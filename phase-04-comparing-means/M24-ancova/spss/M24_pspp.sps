GET DATA /TYPE=TXT /FILE='data/practice.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=a F1.0 b F1.0 replicate F2.0 baseline F8.2 value F8.2.
COMPUTE x=baseline-24.
TEMPORARY.
SELECT IF b=0.
REGRESSION /DEPENDENT=value /METHOD=ENTER a x /STATISTICS=COEFF ANOVA.
COMPUTE ab=a*b.
COMPUTE ax=a*x.
COMPUTE bx=b*x.
COMPUTE abx=a*b*x.
REGRESSION /DEPENDENT=value /METHOD=ENTER a b x /STATISTICS=COEFF ANOVA.
REGRESSION /DEPENDENT=value /METHOD=ENTER a b x ab /STATISTICS=COEFF ANOVA.
REGRESSION /DEPENDENT=value /METHOD=ENTER a b x ab ax bx abx /STATISTICS=COEFF ANOVA.
GET DATA /TYPE=TXT /FILE='data/change.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2 /VARIABLES=a F1.0 baseline F8.2 change F8.2.
COMPUTE x=baseline-24.
REGRESSION /DEPENDENT=change /METHOD=ENTER a x /STATISTICS=COEFF ANOVA.
