GET DATA /TYPE=TXT /FILE='data/practice.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2 /VARIABLES=group_id A1 value F8.2.
RECODE group_id ('A'=1) ('B'=2) ('C'=3) INTO method.
VALUE LABELS method 1 'A' 2 'B' 3 'C'.
ONEWAY value BY method
 /STATISTICS DESCRIPTIVES HOMOGENEITY
 /CONTRAST=-1 0 1
 /POSTHOC=TUKEY.
