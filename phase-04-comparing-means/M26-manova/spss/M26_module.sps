GET DATA /TYPE=TXT /FILE='data/practice.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=a F1.0 b F1.0 replicate F2.0 baseline F8.2 y F8.2 z F8.2 y0 F8.2 z0 F8.2.
GLM y z BY a /METHOD=SSTYPE(3) /PRINT=DESCRIPTIVE HOMOGENEITY /DESIGN=a.
GLM y z BY a b /METHOD=SSTYPE(3) /PRINT=DESCRIPTIVE HOMOGENEITY /DESIGN=a b a*b.
COMPUTE dy=y-y0.
COMPUTE dz=z-z0.
GLM dy dz BY a /METHOD=SSTYPE(3) /PRINT=DESCRIPTIVE /DESIGN=a.
