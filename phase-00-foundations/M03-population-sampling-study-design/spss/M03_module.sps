GET DATA /TYPE=TXT /FILE='data/M03_frame.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=id F5.0 district F2.0 block F3.0 sex F2.0 age F3.0 smoker F2.0
   sbp F4.0 htn F2.0 visit_order F5.0 u F10.6.
FORMATS htn (F8.4).
DESCRIPTIVES VARIABLES=htn /STATISTICS=MEAN SUM.
SORT CASES BY u(A) id(A).
TEMPORARY.
SELECT IF $CASENUM<=10.
LIST VARIABLES=id u htn.
TEMPORARY.
SELECT IF $CASENUM<=10.
FORMATS htn (F8.4).
DESCRIPTIVES VARIABLES=htn /STATISTICS=MEAN SUM.
GET DATA /TYPE=TXT /FILE='data/M03_trial.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2 /VARIABLES=id F5.0 u F10.6.
SELECT IF $CASENUM<=4.
EXECUTE.
SORT CASES BY u(A) id(A).
COMPUTE program=($CASENUM<=2).
LIST VARIABLES=id u program.
