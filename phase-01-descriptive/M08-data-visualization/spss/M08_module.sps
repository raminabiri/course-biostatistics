GET DATA /TYPE=TXT /FILE='data/M08_followup.csv' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=id F3.0 group A2 age F3.0 day0 F6.0 day7 F6.0 day14 F6.0.
RECODE day0 (110 THRU 129=1) (130 THRU 149=2) (150 THRU 169=3) INTO bin.
FREQUENCIES VARIABLES=bin.
COMPUTE change=day14-day0.
FORMATS change (F8.4).
DESCRIPTIVES VARIABLES=change /STATISTICS=MEAN SUM.
